{
  "name": "ee",
  "version": "5.0.25",
  "description": "A fast, desktop software development framework",
  "main": "./public/electron/main.js",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs');const f='node_modules/ppu-pdf/index.js';if(fs.existsSync(f)){let c=fs.readFileSync(f,'utf8');c=c.replace('from\\\"./pdf-reader\\\"','from\\\"./pdf-reader.js\\\"');fs.writeFileSync(f,c);console.log('patched ppu-pdf/index.js')}\"",
    "dev": "ee-bin dev",
    "build": "npm run build-frontend && npm run build-electron && ee-bin encrypt",
    "start": "ee-bin start",
    "dev-frontend": "ee-bin dev --serve=frontend",
    "dev-electron": "ee-bin dev --serve=electron",
    "dev-go": "ee-bin exec --cmds=go",
    "dev-go-w": "ee-bin exec --cmds=go_w",
    "dev-python": "ee-bin exec --cmds=python",
    "build-frontend": "ee-bin build --cmds=frontend && ee-bin move --flag=frontend_dist",
    "build-electron": "ee-bin build --cmds=electron",
    "build-go-w": "ee-bin move --flag=go_static,go_config,go_package && ee-bin build --cmds=go_w",
    "build-go-m": "ee-bin move --flag=go_static,go_config,go_package,go_images && ee-bin build --cmds=go_m",
    "build-go-l": "ee-bin move --flag=go_static,go_config,go_package,go_images && ee-bin build --cmds=go_l",
    "build-python": "ee-bin build --cmds=python && ee-bin move --flag=python_dist",
    "encrypt": "npm run build-electron && ee-bin encrypt",
    "icon": "ee-bin icon",
    "build-w": "npm run build-frontend && npm run build-electron && ee-bin build --cmds=win64",
    "build-we": "npm run build-frontend && npm run build-electron && ee-bin build --cmds=win_e",
    "build-m": "npm run build-frontend && npm run build-electron && ee-bin build --cmds=mac_arm64 && ee-bin updater --platform=macos_apple",
    "build-m-x86": "npm run build-frontend && npm run build-electron && ee-bin build --cmds=mac",
    "build-m-arm64": "npm run build-frontend && npm run build-electron && ee-bin build --cmds=mac_arm64 && ee-bin updater --platform=macos_apple",
    "build-l": "npm run build-frontend && npm run build-electron && ee-bin build --cmds=linux",
    "build-all": "npm run build-frontend && npm run build-electron && ee-bin build --cmds=mac_arm64 && ee-bin build --cmds=mac && ee-bin build --cmds=linux && ee-bin build --cmds=win64",
    "ohos-resources": "ee-bin ohos --cmds=resources",
    "debug-dev": "cross-env DEBUG=ee-* ee-bin dev",
    "debug-encrypt": "ee-bin encrypt",
    "debug-electron": "cross-env DEBUG=ee-* ee-bin dev --serve=electron",
    "debug-move": "ee-bin move --flag=frontend_dist",
    "packages-build": "pnpm --filter ee-bin run build && pnpm --filter ee-core run build",
    "re-sqlite": "electron-rebuild -f -w better-sqlite3"
  },
  
  "repository": "https://github.com/shuaiyinoo/Diting_AI_Desktop.git",
  "keywords": [
    "Diting",
    "Diting RAG",
    "Diting AI"
  ],
  "author": "帅印, <shuaiyinoo@163.com>",
  "license": "Apache-2.0",

  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^7.0.3",
    "debug": "^4.4.0",
    "ee-bin": "^5.0.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.3.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@kreuzberg/node": "^4.9.9",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@zvec/zvec": "^0.5.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.5.0",
    "bytenode": "^1.5.7",
    "canvas": "^3.2.3",
    "chokidar": "^5.0.0",
    "dayjs": "^1.11.13",
    "dingtalk-stream-sdk-nodejs": "^2.0.4",
    "ee-core": "^5.0.1",
    "electron-updater": "^6.7.3",
    "hf-embedder": "^0.2.1",
    "mammoth": "^1.12.0",
    "minisearch": "^7.2.0",
    "onnxruntime-node": "^1.27.0",
    "pdf-efficient-loader": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "ppu-paddle-ocr": "^6.4.0",
    "ppu-pdf": "^6.2.0",
    "qrcode": "^1.5.4",
    "qwen-embedder": "^0.1.5",
    "typebox": "1.1.38"
  }
}
