{
  "productName": "Diting AI",
  "appId": "com.diting.ai",
  "copyright": "© 2025 duola Technology Co., Ltd.",
  "directories": {  
    "output": "out" 
  },
  "asar": true,
  "electronLanguages": ["en-US", "zh-CN"],
  "files": [
    "public",
    "package.json",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "build/extraResources",
      "to": "extraResources"
    },
    {
      "from": "build/extraResources/python-runtime/",
      "to": "python-runtime",
      "filter": ["**/*"]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "shuaiyinoo",
      "repo": "Diting_AI_Desktop"
    }
  ],
  "linux": {
    "icon": "build/icons/icon.icns",
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "target": [
      "deb"
    ],
    "category": "Utility"
  }
}