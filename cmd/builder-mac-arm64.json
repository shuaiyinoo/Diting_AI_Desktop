{
  "productName": "Diting AI",
  "appId": "com.diting.ai",
  "copyright": "© 2025 duola Technology Co., Ltd.",
  "directories": {
    "output": "out"
  },
  "asar": false,
  "electronLanguages": ["en-US", "zh-CN"],
  "files": [
    "public",
    "package.json",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "build/extraResources",
      "to": "extraResources"
    },
    {
      "from": "build/extraResources/python-runtime/",
      "to": "python-runtime",
      "filter": ["**/*"]
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "shuaiyinoo",
      "repo": "Diting_AI_Desktop"
    }
  ],
  "mac": {
    "icon": "build/icons/icon.icns",
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "darkModeSupport": true,
    "hardenedRuntime": false
  }
}