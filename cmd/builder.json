{
  "productName": "Diting",
  "appId": "com.diting.ai",
  "copyright": "© 2025 duola Technology Co., Ltd.",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "node_modules/node-pty/**",
    "node_modules/@kutalia/whisper-node-addon/**",
    "node_modules/better-sqlite3/**",
    "node_modules/canvas/**"
  ],
  "electronLanguages": ["en-US", "zh-CN"],
  "files": [
    "public",
    "package.json",
    "node_modules/**/*",
    "!node_modules/onnxruntime-node/bin/napi-v6/linux",
    "!node_modules/onnxruntime-node/bin/napi-v6/darwin",
    "!node_modules/electron/README.md",
    "!**/*.md",
    "!**/LICENSE",
    "!**/LICENSE.txt",
    "!**/CHANGELOG*",
    "!**/test/**",
    "!**/tests/**",
    "!**/docs/**",
    "!**/.github/**",
    "!**/.bin/**",
    "!**/.cache/**"
  ],
  "extraResources": [
    {
      "from": "build/extraResources/",
      "to": "extraResources"
    },
    {
      "from": "electron/resources/default-skills/",
      "to": "default-skills"
    },
    {
      "from": "build/extraResources/python-runtime/",
      "to": "python-runtime",
      "filter": ["**/*"]
    },
    {
      "from": "electron/resources/funasr-llamacpp/",
      "to": "funasr-llamacpp",
      "filter": ["**/*"]
    }
  ],
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icons/icon.ico",
    "uninstallerIcon": "build/icons/icon.ico",
    "installerHeaderIcon": "build/icons/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Diting"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "shuaiyinoo",
      "repo": "Diting_AI_Desktop"
    }
  ],
  "win": {
    "icon": "build/icons/icon.ico",
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "nsis"
      }
    ]
  }
}