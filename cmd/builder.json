{
  "productName": "Diting AI",
  "appId": "com.diting.ai",
  "copyright": "© 2025 duola Technology Co., Ltd.",
  "directories": {
    "output": "out"
  },
  "asar": true,
  "electronLanguages": ["en-US", "zh-CN"],
  "files": [
    "public",
    "package.json",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "build/extraResources/",
      "to": "extraResources"
    },
    {
      "from": "electron/resources/default-skills/",
      "to": "default-skills"
    },
    {
      "from": "build/extraResources/python-runtime/",
      "to": "python-runtime",
      "filter": ["**/*"]
    }
  ],
  "nsis": {
    "oneClick": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icons/icon.ico",
    "uninstallerIcon": "build/icons/icon.ico",
    "installerHeaderIcon": "build/icons/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Diting AI"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "shuaiyinoo",
      "repo": "Diting_AI_Desktop"
    }
  ],
  "win": {
    "icon": "build/icons/icon.ico",
    "artifactName": "${productName}-${os}-${version}-${arch}.${ext}",
    "target": [
      {
        "target": "nsis"
      }
    ]
  }
}